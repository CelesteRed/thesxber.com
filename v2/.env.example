# Server
PORT=8787
CORS_ORIGIN=http://localhost:5173
# Set this only when the browser and API are hosted on different origins.
# VITE_API_BASE_URL=https://api.example.com

# Exact client IPs allowed to open /admin and use admin upload/delete APIs.
# Use documentation-only placeholder IPs in this committed example.
ADMIN_ALLOWED_IPS=203.0.113.10,198.51.100.25
# Set true when a trusted reverse proxy forwards the real client IP in X-Forwarded-For.
TRUST_PROXY=false

# Keep secrets in .env on the server. Do not commit that file.
ADMIN_API_TOKEN=replace-with-a-long-random-token
YOUTUBE_API_KEY=replace-with-your-youtube-data-api-key
YOUTUBE_CHANNEL_ID=replace-with-your-youtube-channel-id

# Discord bot
DISCORD_BOT_TOKEN=replace-with-your-discord-bot-token
DISCORD_APPLICATION_ID=replace-with-your-discord-application-id
DISCORD_GUILD_ID=replace-with-your-test-server-id
DISCORD_ALLOWED_USER_IDS=discord-user-id-1,discord-user-id-2

# Optional persistent storage overrides (relative to v2/ or absolute paths)
# FANART_DIR=./public/fanart
# FANART_METADATA_FILE=./data/fanart.json
